@page "/products"
@inject ProductService ProductService


@rendermode InteractiveWebAssembly

<PageTitle>Products</PageTitle>

<SectionContent SectionName="AppBar">
    <h3>Products</h3>
</SectionContent>

@if (_products is null)
{
    <div class="row g-3 justify-content-center align-items-center">
        <div class="col-auto spinner-border" role="status"></div>
        <h3 class="col-auto">Loading...</h3>
    </div>
}
else if (_products.Count is 0)
{
    <p>No products found.</p>
}
else
{
    <div class="product-grid">
        @foreach (var product in _products)
        {
            var modalId = $"productModal_{product.Id}";

            <div class="product" data-bs-toggle="modal" data-bs-target="#@modalId">
                <img src="@product.Thumbnail" alt="@product.Title" />
                <div class="product-info">
                    <h3>@product.Title</h3>
                    <p class="price">Price: @product.Price</p>
                    <p class="description">@product.Description</p>
                </div>
            </div>

            <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@modalId + Label" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="@modalId + Label">Modal title</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <ProductDetails ProductId="@product.Id" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Page navigation example" class="d-flex justify-content-center">
        <div class="btn-group" role="group" aria-label="product pagination">
            <button type="button" class="@($"btn btn-outline-primary {(_currentPage is 1 ? "disabled" : "")}")" @onclick="OnGoBackClick">Previous</button>

            @for (var i = 1; i <= _totalPages; i++)
            {
                var pageNumber = i;

                <button type="button" class="@($"btn btn{(_currentPage == i ? "" : "-outline")}-primary")" @onclick="() => OnPageClick(pageNumber)">
                    @i
                </button>
            }

            <button type="button" class="@($"btn btn-outline-primary {(_currentPage == _totalPages ? "disabled" : "")}")" @onclick="OnGoForwardClick">Next</button>

            <div class="btn-group" role="group">
                <button id="rowsPerPageDdl" type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    Items per page: @_pageSize
                </button>
                <ul class="dropdown-menu" aria-labelledby="rowsPerPageDdl">
                    <li><button class="dropdown-item" @onclick="async () => {_pageSize = 8;await OnPageClick(1);}">8</button></li>
                    <li><button class="dropdown-item" @onclick="async () => {_pageSize = 16;await OnPageClick(1);}">16</button></li>
                    <li><button class="dropdown-item" @onclick="async () => {_pageSize = 32;await OnPageClick(1);}">32</button></li>
                </ul>
            </div>
        </div>
    </nav>
}

@code {
    private List<Product>? _products;

    private int _currentPage = 1;
    private int _pageSize = 8;
    private int _totalPages;

    protected override async Task OnInitializedAsync()
    {
        var apiResponse = await ProductService.GetProductsAsync(_pageSize, (_currentPage - 1) * _pageSize);

        _products = apiResponse.Products;
        _totalPages = (int)Math.Ceiling((double)apiResponse.Total / _pageSize); 

        await base.OnInitializedAsync();

    }

    private async Task OnPageClick(int page)
    {
        if (page < 1 || page > _totalPages) return;

        _currentPage = page;

        var apiResponse = await ProductService.GetProductsAsync(_pageSize, (_currentPage - 1) * _pageSize);
        _products = apiResponse.Products;

    }

    private async Task OnGoBackClick()
    {
        
        if (_currentPage > 1)
        {
            await OnPageClick(_currentPage - 1);
            StateHasChanged();
        }


    }

    private async Task OnGoForwardClick()
    {
        
        if (_currentPage < _totalPages)
        {
            await OnPageClick(_currentPage + 1);
            StateHasChanged();
        }
        
    }
}
